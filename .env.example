# 数据库配置
MONGODB_URL=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379

# 病种中心配置
DISEASE_CENTER_MOCK_ENABLED=false
VITE_ENABLE_DISEASE_CENTER_MOCK=false

# AI 模型配置
AI_MODEL_ID=Qwen2-7B-Medical
AI_MODEL_VERSION=1.0.0

# 日志级别
LOG_LEVEL=INFO

# API 配置
API_HOST=0.0.0.0
API_PORT=8000

# 模块角色权限控制（前端 VITE_ 变量，从仓库根 .env 读取）
# true=按模块 requiredRoles 区分医生/护士可见性；false(默认)=所有人可打开全部模块
VITE_ENABLE_MODULE_ROLE_GUARD=false
